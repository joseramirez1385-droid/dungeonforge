    namespace dungeonforge_states {
        class CombatState {
            +onEnter(GameContext) void
            +availableCommands() ListList
            +name() String
        }
        class DeadState {
            +canAct() boolean
            +next(Monster, Player) MonsterState
            +label() String
        }
        class EnragedState {
            +DAMAGE_BONUS : double
            +onEnter(Monster) void
            +canAct() boolean
            +damageMultiplier() double
            +next(Monster, Player) MonsterState
            +label() String
        }
        class ExploringState {
            +availableCommands() ListList
            +name() String
        }
        class FleeingState {
            +DAMAGE_DEFICIT : double
            +onEnter(Monster) void
            +canAct() boolean
            +damageMultiplier() double
            +next(Monster, Player) MonsterState
            +label() String
        }
        class GameOverState {
            +onEnter(GameContext) void
            +availableCommands() ListList
            +name() String
        }
        class GameState {
            <<interface>>
        }
        class HuntingState {
            +canAct() boolean
            +next(Monster, Player) MonsterState
            +label() String
        }
        class IdleState {
            +canAct() boolean
            +next(Monster, Player) MonsterState
            +label() String
        }
        class InventoryState {
            +onEnter(GameContext) void
            +availableCommands() ListList
            +name() String
        }
        class MonsterState {
            <<interface>>
        }
    }

    AbstractCommand ..> TurnSnapshot : captures
    AbstractCommand <|-- AttackCommand
    AbstractCommand <|-- DropCommand
    AbstractCommand <|-- MoveCommand
    AbstractCommand <|-- TakeCommand
    AbstractCommand <|-- UseItemCommand
    CombatStrategy <|.. AggressiveStrategy
    CombatStrategy <|.. HealerStrategy
    CombatStrategy <|.. RangedStrategy
    CombatStrategy <|.. SkittishStrategy
    Command <|.. AbstractCommand
    Command <|.. MacroCommand
    Command <|.. NoCommand
    Command <|.. SimpleCommand
    CommandHistory o-- Command : undo stack
    CommandParser o-- CommandFactory : registry
    DungeonLevel o-- Room : rooms
    EnragedState ..> AggressiveStrategy : onEnter sets
    Entity <|-- Monster
    Entity <|-- Player
    EventBus o-- GameEventListener : subscribers
    FleeingState ..> SkittishStrategy : onEnter sets
    GameContext o-- GameState : current state
    GameEventListener <|.. AchievementSystem
    GameEventListener <|.. CombatLog
    GameEventListener <|.. DangerMeter
    GameEventListener <|.. QuestTracker
    GameState <|.. CombatState
    GameState <|.. ExploringState
    GameState <|.. GameOverState
    GameState <|.. InventoryState
    GameWorld o-- DungeonLevel : levels
    Item <|.. Armor
    Item <|.. Hourglass
    Item <|.. Potion
    Item <|.. Treasure
    Item <|.. Weapon
    MacroCommand o-- Command : children
    Monster o-- CombatStrategy : current strategy
    Monster o-- MonsterState : current state
    MonsterFactory ..> MonsterDef : reads definitions
    MonsterState <|.. DeadState
    MonsterState <|.. EnragedState
    MonsterState <|.. FleeingState
    MonsterState <|.. HuntingState
    MonsterState <|.. IdleState
    Room o-- Monster : monsters
    RoomPopulator <|-- BossRoomPopulator
    RoomPopulator <|-- StandardRoomPopulator
    RoomPopulator <|-- TreasureRoomPopulator
    ThemeKit <|.. CryptThemeKit
    ThemeKit <|.. ForgeThemeKit
    ThemeKit <|.. FrostThemeKit
    ThemeKit <|.. WinterfellThemeKit
    ThemeRegistry o-- ThemeKit : kits
    TurnSnapshot o-- CombatStrategy : saves and restores
    TurnSnapshot o-- MonsterState : saves and restores